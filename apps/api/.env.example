# Copie para apps/api/.env  (cp .env.example .env)
PORT=3333
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hope_v2?schema=public"

# Origem permitida (frontend)
WEB_ORIGIN=http://localhost:5173

# Autenticação própria (e-mail + senha, token assinado).
# AUTH_SECRET assina os tokens de login. Em produção use 32+ caracteres, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=troque-esta-chave
# Validade do token de login, em dias (1 a 90)
TOKEN_TTL_DAYS=7

# Armazenamento de arquivos (infraestrutura ainda NÃO definida)
STORAGE_DRIVER=local          # local | s3 (a definir)
STORAGE_LOCAL_DIR=./uploads
